{
  "title": "brain-lab live layers",
  "uid": "brain-lab",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 0,
      "title": "Layer up",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "ga_feed_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "title": "Layer load time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "ga_feed_request_duration_ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Newest observation age",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "ga_feed_data_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Upstream source errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "ga_feed_source_errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Markers per layer",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "ga_feed_markers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "GTFS-RT staleness",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "transit_gtfs_staleness_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "USGS events (1 h / 30 d)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "usgs_seismic_event_delta or usgs_seismic_events_30d",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active FAA TFRs",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "faa_restriction_active_count",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Browser FPS (median)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "map_render_fps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Frame time p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "map_render_frame_ms_p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Browser JS heap",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "memory_heap_usage_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Download throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "network_io_throughput_mbps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "LCP p75 / INP p75",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "web_vitals_lcp_ms_p75 or web_vitals_inp_ms_p75",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Server heap",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "nodejs_heap_used_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}
